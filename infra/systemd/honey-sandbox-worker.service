[Unit]
Description=Honey Haven Sandbox Worker (simulated unless configured)
After=network.target honey-web.service
Wants=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/honey
EnvironmentFile=/etc/honey/honey.env
ExecStart=/opt/honey/.venv/bin/python manage.py sandbox_worker --loop --interval 60
Restart=always
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/honey/logs /opt/honey/media

[Install]
WantedBy=multi-user.target
