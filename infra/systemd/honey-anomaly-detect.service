[Unit]
Description=Honey Haven Anomaly Detection Worker
After=network.target honey-web.service
Wants=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/honey
EnvironmentFile=/etc/honey/honey.env
ExecStart=/opt/honey/.venv/bin/python manage.py anomaly_detect --loop --interval 300
Restart=always
RestartSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/honey/logs /opt/honey/media

[Install]
WantedBy=multi-user.target
