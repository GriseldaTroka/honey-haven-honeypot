# Example environment file for local development and docker-compose
# Copy this to `.env` and fill in values. DO NOT commit real secrets.

# Django
DJANGO_SECRET_KEY=replace-this-with-a-secret  # Use a secure random 50+ char value in production
DJANGO_DEBUG=True  # Set to False in production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1  # Comma-separated list of allowed hosts
DJANGO_ALLOW_ALL_HOSTS=False  # Set to True only for a controlled lab or temporary testing

# Database (for production prefer Postgres)
DATABASE_URL=sqlite:///db.sqlite3  # For production use a Postgres URL: postgres://user:pass@host:5432/dbname

# Honeypot alerting
HONEYPOT_ALERT_DEDUP_WINDOW_MIN=5
HONEYPOT_ALERT_MAX_PER_WINDOW=10
HONEYPOT_SANDBOX_URL=  # Optional: sandbox API URL (leave empty to use simulated sandbox)
HONEYPOT_SANDBOX_API_KEY=

# Alert destinations (optional)
HONEYPOT_DISCORD_WEBHOOK_URL=
HONEYPOT_TELEGRAM_WEBHOOK_URL=
HONEYPOT_ALERT_EMAIL=

# Docker registry (for CI image publishing)
DOCKER_REGISTRY=
DOCKER_USERNAME=
DOCKER_PASSWORD=

# Local secret files (for local testing only):
# Create infra/secrets/django_secret with the secret and DO NOT commit it.
